# ===== 必填：Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ===== 必填：API-Football (https://www.api-football.com/) =====
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# ===== 数据库 =====
# 本地默认 SQLite；Railway 添加 PostgreSQL 后会自动注入 DATABASE_URL，覆盖此项
DATABASE_URL=sqlite:///./football.db

# ===== 运行配置 =====
TIMEZONE=Asia/Shanghai
ENABLED_LEAGUES=39,140,135,78,61
MIN_HISTORY_MATCHES=5
PREDICTION_ENABLED=true
LOG_LEVEL=INFO

# ===== LLM（暂未启用，预留，留空即可） =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
